<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title><< video_name >></title>
  <!--
    AUTO-GENERATED by viral-shortform-editor
    Source  : << video_name >>
    Clips   : << clips | length >>
    Duration: << total_duration_s >>s

    Edit a caption : find the matching <div id="cg-N"> and change its text content
    Adjust a cut   : change data-media-start (trim offset into source) and data-duration
    Re-render      : cd hyperframes-composition && npx hyperframes render --output ../output.mp4

    NOTE: src paths are relative to index.html. Verify they point to your source files.
  -->
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { background: #000; }

    #stage {
      position: relative;
      width: << width >>px;
      height: << height >>px;
      background: #000;
      overflow: hidden;
    }

    .clip-video {
      position: absolute;
      top: 0; left: 0;
      width: 100%; height: 100%;
      object-fit: cover;
      z-index: 1;
    }

    .broll-video {
      position: absolute;
      top: 0; left: 0;
      width: 100%; height: 100%;
      object-fit: cover;
      z-index: 2;
    }

    .caption-group {
      position: absolute;
      bottom: 18%;
      left: 5%;
      right: 5%;
      text-align: center;
      font-family: 'TikTok Sans', 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 68px;
      font-weight: 500;
      color: #FFFFFF;
      text-transform: lowercase;
      text-shadow: 3px 3px 0 #000, -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000;
      line-height: 1.2;
      letter-spacing: 0.01em;
      z-index: 10;
      opacity: 0;
      visibility: hidden;
    }
  </style>
</head>
<body>
  <div
    id="stage"
    data-composition-id="<< composition_id >>"
    data-start="0"
    data-width="<< width >>"
    data-height="<< height >>"
    data-duration="<< total_duration_s >>"
  >

    <!-- ═══════════════════════════════════════
         TRACK 0 — A-roll video (muted; audio on track 1)
         data-media-start: trim offset into source file (seconds)
         ═══════════════════════════════════════ -->
<% for clip in clips %>
    <video
      id="v-<< clip.clip_idx >>"
      class="clip-video"
      data-start="<< clip.timeline_start_s >>"
      data-duration="<< clip.clip_duration_s >>"
      data-track-index="0"
      data-media-start="<< clip.in_s >>"
      src="<< clip.source_video >>"
      muted
      playsinline
    ></video>
<% endfor %>

    <!-- ═══════════════════════════════════════
         TRACK 1 — A-roll audio (HyperFrames requires video muted + separate audio)
         ═══════════════════════════════════════ -->
<% for clip in clips %>
    <audio
      id="a-<< clip.clip_idx >>"
      data-start="<< clip.timeline_start_s >>"
      data-duration="<< clip.clip_duration_s >>"
      data-track-index="1"
      data-media-start="<< clip.in_s >>"
      data-volume="1"
      src="<< clip.source_video >>"
    ></audio>
<% endfor %>

<% if clips | selectattr('broll_overlay') | list | length > 0 %>
    <!-- ═══════════════════════════════════════
         TRACK 2 — B-roll overlays (z-index: 2 sits above A-roll)
         ═══════════════════════════════════════ -->
<% for clip in clips %>
<% if clip.broll_overlay %>
    <video
      id="bv-<< clip.clip_idx >>"
      class="broll-video"
      data-start="<< clip.timeline_start_s >>"
      data-duration="<< clip.clip_duration_s >>"
      data-track-index="2"
      data-media-start="0"
      src="<< clip.broll_overlay >>"
      muted
      playsinline
    ></video>
<% endif %>
<% endfor %>
<% endif %>

<% if music_track %>
    <!-- ═══════════════════════════════════════
         TRACK 3 — Background music (15% volume, under speech)
         ═══════════════════════════════════════ -->
    <audio
      id="music"
      data-start="0"
      data-duration="<< total_duration_s >>"
      data-track-index="3"
      data-volume="0.15"
      src="<< music_track >>"
    ></audio>
<% endif %>

    <!-- ═══════════════════════════════════════
         TRACK 4 — Captions (GSAP-animated, z-index: 10)
         Max 5 words per group. Edit text inside any <div id="cg-N-G"> and re-render.
         ═══════════════════════════════════════ -->
<% for g in caption_groups_flat %>
    <div id="cg-<< g.clip_idx >>-<< g.group_idx >>" class="caption-group"><< g.caption_html >></div>
<% endfor %>

  </div><!-- /stage -->

  <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
  <script>
    window.__timelines = window.__timelines || {};
    var tl = gsap.timeline({ paused: true });

    var CAPTIONS = [
<% for g in caption_groups_flat %>
      {
        id: "cg-<< g.clip_idx >>-<< g.group_idx >>",
        start: << g.abs_start >>,
        end: << "%.3f" | format(g.abs_start + g.duration) >>
      }<< "," if not loop.last else "" >>
<% endfor %>
    ];

    CAPTIONS.forEach(function(g) {
      var el = document.getElementById(g.id);
      if (!el) return;
      var dur = g.end - g.start;

      // Make visible, animate in
      tl.set(el,  { visibility: "visible", opacity: 0, y: 18 }, g.start);
      tl.to(el,   { opacity: 1, y: 0, duration: Math.min(0.15, dur * 0.2), ease: "power2.out" }, g.start);

      // Fade out just before clip ends, then hard-kill
      var exitAt = g.end - Math.min(0.12, dur * 0.15);
      tl.to(el,  { opacity: 0, duration: 0.12, ease: "power2.in" }, exitAt);
      tl.set(el, { opacity: 0, visibility: "hidden" }, g.end);
    });

    // Self-lint: warn if any caption leaks past its end time
    CAPTIONS.forEach(function(g) {
      var el = document.getElementById(g.id);
      if (!el) return;
      tl.seek(g.end + 0.01);
      var cs = window.getComputedStyle(el);
      if (cs.opacity !== "0" && cs.visibility !== "hidden") {
        console.warn("[caption-lint] " + g.id + " still visible at t=" + (g.end + 0.01).toFixed(2) + "s");
      }
    });
    tl.seek(0);

    window.__timelines["<< composition_id >>"] = tl;
  </script>
</body>
</html>
